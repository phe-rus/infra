{
    "name": "infra-monorepo",
    "private": true,
    "license": "MIT",
    "type": "module",
    "workspaces": [
        "infra",
        "accounts",
        "www",
        "apps/*",
        "shared/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "deploy": "turbo run deploy",
        "type-gen": "turbo run type-gen",
        "lint": "biome lint .",
        "check": "biome format .",
        "postinstall": "turbo run type-gen",
        "typecheck": "turbo run typecheck",
        "format": "biome format --write ."
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10",
        "@types/bun": "^1",
        "turbo": "^2.10.12",
        "typescript": "^7"
    },
    "packageManager": "bun@1.4.0"
}
