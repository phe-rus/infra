{
    "name": "infra-monorepo",
    "private": true,
    "license": "MIT",
    "type": "module",
    "workspaces": {
        "packages": [
            "www",
            "infra",
            "accounts",
            "shared/*"
        ],
        "catalog": {
            "react": "^19.3.0",
            "react-dom": "^19.3.0",
            "typescript": "^7.0.2",
            "@types/react": "^19.3.0",
            "@types/react-dom": "^19.3.0",
            "zod": "^4.6.5"
        },
        "catalogs": {
            "tanstack": {
                "vite": "^8.3.1",
                "wrangler": "^4.141.0"
            }
        }
    },
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "deploy": "turbo run deploy",
        "type-gen": "turbo run type-gen",
