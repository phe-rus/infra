{
    "name": "infra-monorepo",
    "private": true,
    "type": "module",
    "workspaces": [
        "infra",
        "www",
        "plugins/*",
        "shared/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "deploy": "turbo run build",
        "type-gen": "turbo run type-gen",
        "lint": "biome lint .",
        "test": "turbo run test",
        "check": "biome format .",
        "typecheck": "turbo run typecheck",
        "format": "biome format --write ."
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.9",
        "@types/bun": "^1",
        "turbo": "^2.10.11",
        "typescript": "^7"
    },
    "packageManager": "bun@1.3.14"
}
