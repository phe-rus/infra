{
    "include": [
        "**/*.ts"
    ],
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": [
            "@cloudflare/workers-types"
        ],
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true
    },
    "exclude": [
        "node_modules",
        "dist"
    ]
}
