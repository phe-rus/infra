{
    "$schema": "node_modules/turbo/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [
                ".output/**",
                "dist/**",
                ".tanstack/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "deploy": {
            "dependsOn": ["^deploy"]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"]
        },
        "type-gen": {
            "dependsOn": ["^type-gen"]
        }
    }
}
