{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": [
        ".output/**",
        "dist/**"
      ]
    },
    "format": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "type-gen": {
      "dependsOn": [
        "^type-gen"
      ]
    }
  }
}