{
    "$schema": "https://v2-10-11.turborepo.dev/schema.json",
    "ui": "tui",
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "outputs": [".output/**", "dist/**"]
        },
        "deploy": {
            "dependsOn": ["^deploy"]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"]
        },
        "type-gen": {
            "dependsOn": ["^type-gen"]
        }
    }
}
