{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "infraccount",
    "compatibility_date": "2026-08-08",
    "compatibility_flags": ["nodejs_compat"],
    "main": "src/server.ts",
    "observability": {
        "enabled": false
    },
    "workers_dev": false,
    "preview_urls": false,
    "routes": [
        {
            "custom_domain": true,
            "pattern": "infraccount.pherus.org"
        }
    ]
}
