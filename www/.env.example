# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it.

# accounts's base URL — where the "sign in" link points. Defaults to
# accounts's local dev server; set to the real deployed accounts URL in production.
VITE_ACCOUNTS_URL=http://localhost:3001

# Cloudflare Vite plugin's local request/span capture during dev — see
# infra/CLAUDE.md's "Known issues" section before enabling, it has real overhead
X_LOCAL_OBSERVABILITY=false
