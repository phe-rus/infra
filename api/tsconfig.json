{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "lib": ["ESNext"],
        "types": ["bun", "./worker-configuration.d.ts"],
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx"
    },
    "include": ["src", "**/**/*.ts", "worker-configuration.d.ts"],
    "exclude": ["node_modules"]
}
