{
    "include": ["**/*.ts", "**/*.tsx"],
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "paths": {
            "@infra/ui/*": ["./src/*"]
        }
    },
    "exclude": ["node_modules", "dist"]
}
