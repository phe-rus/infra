# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it, it holds real secrets.

# Authorizes requests to /api/migrate. Generate your own: openssl rand -hex 32
MIGRATION_SECRET=

# better-auth's signing secret. Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000
# www's URL — the OAuth provider's loginPage/consentPage/signUp.page render
# there, not on infra itself
WWW_URL=http://localhost:3001
NODE_ENV=development
VITE_APPNAME=infra

# Cookie domain for cross-subdomain sessions in production; leave blank for local dev
COOKIE_DOMAIN=

# Comma-separated list of trusted origins (bare hostnames, no protocol/port —
# only the hostname is checked, so "localhost" already covers every local app
# regardless of port, e.g. www/ on :3001; in production list the shared parent
# domain, e.g. "pherus.org", to cover every *.pherus.org subdomain via suffix match)
TRUSTED_ORIGINS=localhost

# Cloudflare Vite plugin's local request/span capture during dev — see
# CLAUDE.md's "Known issues" section before enabling, it has real overhead
X_LOCAL_OBSERVABILITY=false

# PawaPay API token — from the sandbox dashboard (dashboard.sandbox.pawapay.io)
# or the production dashboard, depending on PAWAPAY_ENV below
PAWAPAY_API_TOKEN=
PAWAPAY_ENV=sandbox

# Dodo Payments — dev-only rail, entirely inert (payProvider's dodo option
# stays undefined) unless DODO_API_KEY is set. From the Dodo dashboard.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# the one static "pay what you want" product id, created once in the
# dashboard — every checkout references this same id with a dynamic amount
DODO_CHECKOUT_ID=
# optional: a credit entitlement id already attached to DODO_CHECKOUT_ID,
# only needed if a checkout should also grant/top-up a credit balance
DODO_CREDIT_ENTITLEMENT_ID=

# Resend API key — from https://resend.com/api-keys. RESEND_FROM_EMAIL
# defaults to Resend's shared onboarding@resend.dev test sender, which works
# without verifying a domain but may restrict which recipients can receive
# mail — verify your own domain in Resend and swap this once you have one
RESEND_API_KEY=
RESEND_FROM_EMAIL="infra <onboarding@resend.dev>"
