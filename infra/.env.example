# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it, it holds real secrets.

MIGRATION_SECRET=
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000
WWW_URL=http://localhost:3001
NODE_ENV=development
VITE_APPNAME=infra

COOKIE_DOMAIN=localhost
TRUSTED_ORIGINS=localhost

RESEND_API_KEY=
RESEND_FROM_EMAIL="infra <support@pherus.org>"

# Needed to read back EA/EM analytics events (writes work without these; only
# reading the /logs and /settings/metrics pages needs them). Get CF_ACCOUNT_ID
# from the Cloudflare dashboard sidebar. Create CF_ANALYTICS_API_TOKEN at
# dash.cloudflare.com -> My Profile -> API Tokens -> Create Token, with
# "Account Analytics" Read permission scoped to this account.
CF_ACCOUNT_ID=
CF_ANALYTICS_API_TOKEN=

VITE_BASE_URL=http://localhost:3000

# Cloudflare Vite plugin's local request/span capture during dev — see
# CLAUDE.md's "Known issues" section before enabling, it has real overhead
X_LOCAL_OBSERVABILITY=false
