# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it, it holds real secrets.

MIGRATION_SECRET=
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000
ACCOUNTS_URL=http://localhost:3001
NODE_ENV=development
VITE_APPNAME=infra

COOKIE_DOMAIN=localhost
TRUSTED_ORIGINS=localhost

RESEND_API_KEY=
RESEND_FROM_EMAIL="infra <support@pherus.org>"

VITE_BASE_URL=http://localhost:3000

# Cloudflare Vite plugin's local request/span capture during dev — see
# CLAUDE.md's "Known issues" section before enabling, it has real overhead
X_LOCAL_OBSERVABILITY=false
