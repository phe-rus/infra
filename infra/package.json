{
    "name": "infra",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite dev --port=3000",
        "build": "NODE_ENV=production vite build",
        "preview": "vite preview --port=3000",
        "deploy": "wrangler deploy",
        "type-gen": "wrangler types",
        "typecheck": "tsc --noEmit",
        "postinstall": "bun run type-gen",
        "auth:gen": "bun x auth@latest generate --config=./auth/auth.ts --output=./schemas/auth.ts --yes",
        "db:gen": "bunx drizzle-kit generate --config=drizzle.config.ts",
        "db:local": "bunx wrangler d1 migrations apply infra-authentication --local",
        "db:remote": "bunx wrangler d1 migrations apply infra-authentication --remote",
        "db:studio": "bunx drizzle-kit studio --config=drizzle.config.ts",
        "local": "bun run db:gen && bun run db:local",
        "remote": "bun run local && bun run db:remote"
    },
    "dependencies": {
        "@better-auth/core": "1.7.5",
        "@better-auth/drizzle-adapter": "1.7.5",
        "@better-auth/oauth-provider": "1.7.5",
        "@better-auth/passkey": "1.7.5",
        "@fontsource-variable/inter": "^5.3.0",
        "@hugeicons/core-free-icons": "^4.3.0",
        "@hugeicons/react": "^1.1.10",
        "@infra/assets": "workspace:*",
        "@infra/tanstack-image": "workspace:*",
        "@infra/ui": "workspace:*",
        "@simplewebauthn/server": "^14.0.2",
        "@tailwindcss/vite": "^4",
        "@tanstack/react-devtools": "^0.10.12",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-query-devtools": "^5.102.5",
        "@tanstack/react-router": "^1.170.32",
        "@tanstack/react-router-devtools": "^1.167.1",
        "@tanstack/react-router-ssr-query": "^1.167.1",
        "@tanstack/react-start": "^1.168.49",
        "@tanstack/router-plugin": "^1.168.35",
        "better-auth": "1.7.5",
        "date-fns": "^4.4.0",
        "drizzle-orm": "^1.0.0-rc.4",
        "react": "catalog:",
        "react-dom": "catalog:",
        "recharts": "3.8.0",
        "reflect-metadata": "^0.2.2",
        "tailwindcss": "^4",
        "ua-parser-js": "^2.0.10",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.54.0",
        "@infra/minifybuild": "workspace:*",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tanstack/devtools-vite": "^0.8.5",
        "@types/node": "^26",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "^6",
        "babel-plugin-react-compiler": "^1.0.0",
        "drizzle-kit": "^1.0.0-rc.4",
        "typescript": "catalog:",
        "vite": "catalog:tanstack",
        "web-vitals": "^6.2.0",
        "wrangler": "catalog:tanstack"
    }
}