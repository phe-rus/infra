{
    "name": "infra",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite dev --port=3001",
        "build": "vite build",
        "preview": "vite preview --port=3001",
        "deploy": "wrangler deploy",
        "type-gen": "wrangler types",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "postinstall": "bun run type-gen",
        "auth:gen": "bun x auth@latest generate --config=./auth/auth.ts --output=./schemas/auth.ts --yes",
        "db:gen": "bunx drizzle-kit generate --config=drizzle.config.ts",
        "db:local": "bunx wrangler d1 migrations apply infra-authentication --local",
        "db:remote": "bunx wrangler d1 migrations apply infra-authentication --remote",
        "db:studio": "bunx drizzle-kit studio --config=drizzle.config.ts",
        "local": "bun run db:gen && bun run db:local",
        "remote": "bun run local && bun run db:remote"
    },
    "dependencies": {
        "@better-auth/core": "1.7.2",
        "@better-auth/drizzle-adapter": "^1.7.2",
        "@better-auth/oauth-provider": "1.7.2",
        "@better-auth/passkey": "1.7.2",
        "@better-auth/utils": "0.5.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@infra/auth": "workspace:*",
        "@infra/notify": "workspace:*",
        "@infra/payprovider": "workspace:*",
        "@infra/r2": "workspace:*",
        "@infra/tanstack-image": "workspace:*",
        "@infra/ui": "workspace:*",
        "@simplewebauthn/server": "^13.3.3",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^1.0.0-rc.4",
        "@tabler/icons-react": "^3.46.0",
        "@tailwindcss/vite": "^4",
        "@tanstack/react-devtools": "^0.10.12",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-query-devtools": "^5.102.5",
        "@tanstack/react-router": "^1.170.32",
        "@tanstack/react-router-devtools": "^1.167.1",
        "@tanstack/react-router-ssr-query": "^1.167.1",
        "@tanstack/react-start": "^1.168.49",
        "@tanstack/router-plugin": "^1.168.35",
        "better-auth": "1.7.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4",
        "ua-parser-js": "^2.0.10",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.54.0",
        "@infra/minifybuild": "workspace:*",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tanstack/devtools-vite": "^0.8.5",
        "@types/node": "^26",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6",
        "babel-plugin-react-compiler": "^1.0.0",
        "drizzle-kit": "^1.0.0-rc.4",
        "jsdom": "^30",
        "typescript": "^7",
        "web-vitals": "^6.2.0",
        "vite": "^8",
        "vitest": "^4",
        "wrangler": "^4.126.0"
    }
}
